{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fazenda",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "fazenda-exemplo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.NEXT_PUBLIC_MODO_EXEMPLO='1';process.env.NEXT_DIST_DIR='.next-exemplo';const {execSync,spawn}=require('child_process');execSync('npx next build',{stdio:'inherit',env:process.env});spawn('npx',['next','start','--port','3101'],{stdio:'inherit',shell:true,env:process.env})"
      ],
      "port": 3101
    }
  ]
}
